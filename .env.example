# certifixes environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─── Required ──────────────────────────────────────────────────────────────────

# Default contact email used for all ACME registrations and certificate alerts
CERTIFIXES_EMAIL=you@yourdomain.com

# ─── Alerting (set at least one) ───────────────────────────────────────────────

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key

# ─── DNS Providers (required for DNS-01 challenges / wildcard certs) ───────────

# Cloudflare — requires Zone:DNS:Edit permission
CF_API_TOKEN=your-cloudflare-api-token

# AWS Route 53
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=us-east-1

# Google Cloud DNS
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCE_PROJECT=your-gcp-project-id

# Azure DNS
# AZURE_CLIENT_ID=your-azure-client-id
# AZURE_CLIENT_SECRET=your-azure-client-secret
# AZURE_TENANT_ID=your-azure-tenant-id
# AZURE_SUBSCRIPTION_ID=your-azure-subscription-id

# DigitalOcean
# DO_AUTH_TOKEN=your-digitalocean-api-token

# ─── Dashboard ─────────────────────────────────────────────────────────────────

# Secret used to sign dashboard session tokens — generate with: openssl rand -hex 32
# App will refuse to start if this is empty.
CERTIFIXES_DASHBOARD_SECRET=

# Port for web dashboard (default: 8080)
# CERTIFIXES_DASHBOARD_PORT=8080
